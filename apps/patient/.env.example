# ============================================================================
#  App Pasien — konfigurasi build
#
#  Flutter tidak membaca berkas .env saat runtime; nilai disuntikkan saat
#  build lewat --dart-define. Berkas ini adalah DOKUMENTASI nilai yang tersedia.
#
#  Cara pakai (salin jadi env.json lalu):
#    flutter run --dart-define-from-file=env.json
#
#  Atau langsung:
#    flutter run --dart-define=API_URL=http://10.0.2.2:4000
# ============================================================================

# Alamat backend.
#   Emulator Android : http://10.0.2.2:4000   (10.0.2.2 = localhost host)
#   Perangkat fisik  : http://<IP-LAN-komputer>:4000
#   Chrome / desktop : http://localhost:4000
API_URL=http://10.0.2.2:4000

# OPSIONAL — Google Maps.
# Kosong  = memakai ConsoleMap: peta skematik bergaya mockup. Semua fitur
#           tetap jalan; posisi pin tetap dihitung dari koordinat asli.
# Terisi  = memakai Google Maps sungguhan. Aktifkan "Maps SDK for Android"
#           di Google Cloud Console, dan tambahkan juga key-nya ke
#           android/app/src/main/AndroidManifest.xml sebagai meta-data
#           com.google.android.geo.API_KEY.
GOOGLE_MAPS_API_KEY=
