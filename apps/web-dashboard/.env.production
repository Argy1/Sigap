# ============================================================================
#  Nilai build production — dibaca otomatis oleh Next.js saat `next build`.
#
#  Aman di-commit: NEXT_PUBLIC_API_URL adalah URL publik backend (bukan
#  kredensial), dan NEXT_PUBLIC_GOOGLE_MAPS_API_KEY — kalau nanti diisi — akan
#  jadi browser key yang memang dirancang untuk terlihat publik (dibatasi lewat
#  HTTP referrer di Google Cloud Console, bukan lewat kerahasiaan).
#
#  Next.js meng-inline NEXT_PUBLIC_* ke dalam bundle client SAAT BUILD, jadi
#  nilainya harus tersedia sebelum `next build` berjalan — bukan sesuatu yang
#  bisa diubah setelah deploy tanpa build ulang.
# ============================================================================

NEXT_PUBLIC_API_URL=https://sigap-backend-production-d4c1.up.railway.app
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
