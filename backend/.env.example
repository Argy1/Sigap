# ============================================================================
#  Backend — Aplikasi Panggilan Darurat Ambulans (Kota Bogor)
#  Salin file ini jadi `.env` lalu isi nilainya. JANGAN commit `.env`.
# ============================================================================

NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Database — PostgreSQL 16 + ekstensi PostGIS 3.4 (di-host di Railway)
# Ambil dari Railway → project → service `postgis` → Variables → TCP Proxy.
# Formatnya: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://ambulans:PASSWORD@HOST.proxy.rlwy.net:PORT/ambulans

# Set `true` kalau server database mewajibkan TLS (mis. Railway public proxy).
# Untuk PostGIS lokal lewat docker-compose, biarkan `false`.
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# JWT — WAJIB diganti dengan nilai acak sendiri di production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=ganti-dengan-string-acak-panjang
JWT_REFRESH_SECRET=ganti-dengan-string-acak-panjang-yang-berbeda
JWT_CALL_SECRET=ganti-dengan-string-acak-panjang-untuk-guest-call-token

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Umur call token mode tamu — cukup panjang untuk memantau satu panggilan sampai selesai.
JWT_CALL_TTL=6h

# ---------------------------------------------------------------------------
# CORS — origin dashboard web (pisahkan dengan koma kalau lebih dari satu)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------------------------------------------------------------------------
# Google Maps (OPSIONAL)
#
# Kalau KOSONG, backend otomatis pakai mode fallback:
#   - jarak/ETA dihitung haversine x 1.35 (koreksi jalan kota) @ 32 km/jam
#   - reverse geocoding mengembalikan "Lokasi GPS <lat>, <lng>"
# Aplikasi tetap jalan penuh tanpa key ini.
#
# Kalau DIISI, aktifkan API berikut di Google Cloud Console:
#   1. Distance Matrix API   -> refine urutan RS/sopir terdekat (jarak tempuh jalan)
#   2. Geocoding API         -> reverse geocoding alamat pasien
# (Dua lagi dipakai di sisi client, bukan di sini:
#   3. Maps SDK for Android  -> peta di App Pasien & App Sopir
#   4. Maps JavaScript API   -> peta di Dashboard Web)
#
# Key ini HANYA dipakai server-side supaya tidak bocor ke client dan supaya
# guest-mode SOS tetap bisa jalan tanpa auth.
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Parameter dispatch
# ---------------------------------------------------------------------------
# Berapa kandidat RS yang diambil PostGIS sebelum di-refine jarak tempuh jalan.
NEAREST_HOSPITAL_CANDIDATES=5
# Posisi sopir dianggap basi kalau lebih lama dari ini (detik).
DRIVER_LOCATION_MAX_AGE_SECONDS=300
